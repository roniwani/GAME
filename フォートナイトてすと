setTimeout(function(){
  const ai = document.getElementById('admin-code'), ab = document.getElementById('admin-badge'), abtns = document.getElementById('admin-buttons');
  if (!ai) { console.error('admin-code input not found'); return; }
  const codesEntered = new Set();
  ai.addEventListener('input', (e) => {
    const v = e.target.value.trim();
    if (v === ADMIN_CODE) {
      isGodMode = true; ab.classList.add('active'); ai.style.borderColor = '#ffe66d'; ai.style.color = '#ffe66d'; if (abtns) abtns.classList.add('active');
      const s = window.getGS ? window.getGS() : null;
      if (s && s.players && s.players[0]) s.players[0].isGodMode = true;
    }
    if (CODE_ACTIONS[v] && !codesEntered.has(v)) {
      codesEntered.add(v);
      CODE_ACTIONS[v]();
      ai.value = ''; ai.blur(); // 入力欄を閉じてゲーム操作に戻す
      return;
    }
    if (v !== ADMIN_CODE && !Object.keys(CODE_ACTIONS).some(k => v.startsWith(k))) {
      ab.classList.remove('active'); if (abtns) abtns.classList.remove('active'); ai.style.borderColor = '#4ecdc4'; ai.style.color = '#4ecdc4';
    }
  });
