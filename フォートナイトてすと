<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Battle Arena</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0a0a15;font-family:'Orbitron','Hiragino Sans','Yu Gothic','Meiryo',sans-serif;overflow:hidden}
#game-wrap{width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;position:relative}
canvas{border:3px solid #4ecdc4;border-radius:10px;box-shadow:0 0 40px rgba(78,205,196,0.35);cursor:crosshair}
.admin-panel{position:fixed;top:14px;right:14px;display:flex;flex-direction:column;align-items:flex-end;gap:5px;z-index:99999;pointer-events:auto}
.admin-input{background:rgba(10,10,25,0.95);border:2px solid #4ecdc4;border-radius:6px;color:#4ecdc4;font-family:'Orbitron',sans-serif;font-size:12px;padding:6px 10px;width:150px;outline:none;text-align:right;pointer-events:auto}
.admin-input::placeholder{color:rgba(78,205,196,0.45)}
.admin-badge{background:linear-gradient(90deg,#ffe66d,#ff9f43);color:#1a1a2e;font-size:11px;font-weight:700;padding:4px 10px;border-radius:4px;display:none;animation:pulse 1.5s infinite}
.admin-badge.active{display:block}
.admin-buttons{display:none;flex-direction:column;gap:4px;margin-top:4px;pointer-events:auto}
.admin-buttons.active{display:flex}
.admin-btn{background:rgba(255,230,109,0.18);border:1px solid #ffe66d;color:#ffe66d;font-family:'Orbitron',sans-serif;font-size:10px;padding:5px 10px;border-radius:4px;cursor:pointer;text-align:right;pointer-events:auto}
.admin-btn:hover{background:rgba(255,230,109,0.35)}
.admin-hint{color:rgba(78,205,196,0.55);font-size:9px;text-align:right}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.8;transform:scale(1.05)}}

#toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:rgba(20,10,30,0.92);border:2px solid #ff6bd6;color:#ffd6f3;padding:10px 18px;border-radius:8px;font-size:14px;z-index:100000;opacity:0;transition:opacity .25s;pointer-events:none;max-width:90vw;text-align:center}

/* ===== スタートメニュー ===== */
.menu{position:fixed;inset:0;overflow:auto;display:flex;flex-direction:column;align-items:center;padding:36px 20px 40px;background:radial-gradient(ellipse at 50% 0%,#17314a 0%,#0a0a15 70%);color:#e8fffd}
.menu h1{font-size:44px;letter-spacing:6px;color:#4ecdc4;text-shadow:0 0 24px rgba(78,205,196,.6);margin-bottom:6px}
.menu-sub{font-size:12px;color:rgba(232,255,253,.55);margin-bottom:26px}
.menu-sec{font-size:15px;color:#ffe66d;margin:18px 0 10px;align-self:center}
.row{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;max-width:900px}
.opt,.map-card{font-family:inherit;color:#e8fffd;background:rgba(255,255,255,.05);border:2px solid rgba(255,255,255,.18);border-radius:10px;padding:12px 14px;cursor:pointer;text-align:center;transition:transform .12s,border-color .12s,background .12s}
.opt{width:200px;--c:#4ecdc4}
.map-card{width:200px}
.opt:hover,.map-card:hover{transform:translateY(-2px);background:rgba(255,255,255,.1)}
.opt.sel{border-color:var(--c);background:rgba(255,255,255,.12);box-shadow:0 0 18px var(--c)}
.map-card.sel{border-color:#4ecdc4;background:rgba(78,205,196,.14);box-shadow:0 0 18px rgba(78,205,196,.55)}
.opt-name{font-size:17px;font-weight:700;margin-bottom:5px}
.opt-desc{font-size:11px;color:rgba(232,255,253,.7);line-height:1.5}
.map-prev{height:64px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:32px;margin-bottom:8px}
.start-btn{margin-top:30px;font-family:inherit;font-size:22px;font-weight:700;letter-spacing:6px;color:#0a0a15;background:linear-gradient(90deg,#4ecdc4,#ffe66d);border:none;border-radius:10px;padding:14px 64px;cursor:pointer;box-shadow:0 0 26px rgba(78,205,196,.5)}
.start-btn:hover{filter:brightness(1.12)}
.menu-sel{margin-top:14px;font-size:12px;color:rgba(232,255,253,.7)}
</style>
</head>
<body>
<div id="game-wrap"><div id="root"></div></div>
<div id="toast"></div>

<div class="admin-panel">
<input type="text" class="admin-input" id="admin-code" placeholder="コード入力..." maxlength="10" autocomplete="off"/>
<div class="admin-badge" id="admin-badge">GOD MODE ON</div>
<div class="admin-buttons" id="admin-buttons">
<div class="admin-hint">管理者コマンド</div>
<button class="admin-btn" id="btn-killall">全敵一掃</button>
<button class="admin-btn" id="btn-heal">全回復</button>
<button class="admin-btn" id="btn-maxammo">弾薬MAX</button>
<button class="admin-btn" id="btn-speed">スピードUP</button>
<button class="admin-btn" id="btn-spawn">敵追加x5</button>
</div>
</div>

<script type="text/babel">
const { useState, useEffect, useRef, useCallback } = React;

const BASE_WEAPONS = {
  fists: { id:'fists', name:'拳', type:'melee', damage:10, fireRate:500, ammo:Infinity, maxAmmo:Infinity, spread:0, projectileSpeed:0 },
  shotgun: { id:'shotgun', name:'ショットガン', type:'ranged', damage:20, fireRate:800, ammo:150, maxAmmo:150, spread:0.4, projectileSpeed:700 },
  rifle: { id:'rifle', name:'アサルトライフル', type:'ranged', damage:12, fireRate:80, ammo:150, maxAmmo:150, spread:0.08, projectileSpeed:900 },
  machinegun: { id:'machinegun', name:'マシンガン', type:'ranged', damage:8, fireRate:60, ammo:150, maxAmmo:150, spread:0.2, projectileSpeed:850 },
  rocket: { id:'rocket', name:'ロケットランチャー', type:'explosive', damage:100, fireRate:2000, ammo:150, maxAmmo:150, spread:0, projectileSpeed:350 },
};

let WEAPONS = { ...BASE_WEAPONS };
const WORLD_SIZE = 8000;
const CENTER = WORLD_SIZE / 2;
const INITIAL_ALLIES = 3;
const ADMIN_CODE = '2020';

// ===== 難易度 =====
const DIFFS = {
  easy:   { name:'イージー', desc:'敵20体・体力低め・攻撃弱め\nゾーンダメージ小', color:'#2ecc71', enemies:20, enemyHp:35, enemyDmg:3, enemySpeed:0.85, detect:450, playerShield:100, zoneDmg:2 },
  normal: { name:'ノーマル', desc:'敵30体・標準バランス', color:'#ffe66d', enemies:30, enemyHp:50, enemyDmg:5, enemySpeed:1, detect:600, playerShield:50, zoneDmg:3 },
  hard:   { name:'ハード', desc:'敵45体・体力高め・高速\nシールドなしスタート', color:'#e74c3c', enemies:45, enemyHp:80, enemyDmg:8, enemySpeed:1.2, detect:800, playerShield:0, zoneDmg:5 },
};

// ===== マップ =====
const MAPS = {
  grass:   { name:'草原', icon:'🌳', desc:'標準マップ。木と家が多く隠れやすい', bg:'#2d5a3d', ground:['#3a7a4a','#347a44','#2e7040','#3d8550'], road:'#8B7355', treeStyle:'tree', trees:240, rocks:80, houses:30, pools:0 },
  desert:  { name:'砂漠', icon:'🌵', desc:'遮蔽物が少なく家も少ない', bg:'#c9a05a', ground:['#d9b36c','#cfa75f','#e0bd7a','#d4ae68'], road:'#a67c3d', treeStyle:'cactus', trees:110, rocks:140, houses:12, pools:0 },
  snow:    { name:'雪原', icon:'❄️', desc:'針葉樹が多い雪のマップ', bg:'#dfe9ee', ground:['#e8f1f5','#dde9ef','#f2f7fa','#d6e4ec'], road:'#9fb3bf', treeStyle:'pine', trees:300, rocks:60, houses:24, pools:0 },
  volcano: { name:'火山', icon:'🌋', desc:'溶岩だまりに入るとダメージ！', bg:'#2b1a1a', ground:['#3b2a2a','#332323','#443030','#2d1f1f'], road:'#5a4a4a', treeStyle:'dead', trees:90, rocks:170, houses:16, pools:16 },
};

function makeDecor(count) {
  const items = [];
  for (let i = 0; i < count; i++) {
    const a = Math.random() * Math.PI * 2;
    const d = 200 + Math.random() * (WORLD_SIZE/2 - 300);
    items.push({ x: CENTER + Math.cos(a)*d, y: CENTER + Math.sin(a)*d, r: 15 + Math.random()*25 });
  }
  return items;
}
function makeWorld(mapKey) {
  const m = MAPS[mapKey];
  const houses = [];
  for (let i = 0; i < m.houses; i++) {
    const a = Math.random() * Math.PI * 2;
    const d = 300 + Math.random() * 2200;
    houses.push({ x: CENTER + Math.cos(a)*d, y: CENTER + Math.sin(a)*d, w: 70, h: 50 });
  }
  const pools = [];
  for (let i = 0; i < m.pools; i++) {
    const a = Math.random() * Math.PI * 2;
    const d = 900 + Math.random() * 2400;
    pools.push({ x: CENTER + Math.cos(a)*d, y: CENTER + Math.sin(a)*d, r: 70 + Math.random()*60 });
  }
  return { m, trees: makeDecor(m.trees), rocks: makeDecor(m.rocks), houses, pools };
}

function createPlayer(diff) {
  const ammo = {};
  Object.keys(WEAPONS).forEach(k => ammo[k] = WEAPONS[k].maxAmmo);
  return { id:'player', position:{x:CENTER,y:CENTER}, angle:0, health:100, maxHealth:100, shield:diff.playerShield, maxShield:100, ammo, currentWeapon:'rifle', isBuilding:false, buildMode:null, materials:{wood:500,stone:500,metal:500}, isGodMode:false, speedBoost:1 };
}
function createAlly(i, pp) {
  const a = Math.random()*Math.PI*2, d = 100 + Math.random()*80;
  return { id:`ally-${i}`, position:{x:pp.x+Math.cos(a)*d,y:pp.y+Math.sin(a)*d}, health:80, maxHealth:80, state:'follow', lastAttackTime:0 };
}
// 敵はマップ中央付近(中心から約700〜1300)の4つの集団に配置
function createEnemy(i, diff, idPrefix) {
  const cl = i % 4;
  const ca = (cl/4) * Math.PI * 2 + Math.PI/4;
  const cx = CENTER + Math.cos(ca) * 1000, cy = CENTER + Math.sin(ca) * 1000;
  const oa = Math.random() * Math.PI * 2, od = Math.random() * 300;
  return { id:`${idPrefix || 'enemy-'}${i}`, position:{x:cx+Math.cos(oa)*od, y:cy+Math.sin(oa)*od}, health:diff.enemyHp, maxHealth:diff.enemyHp, state:'patrol', targetId:null, lastAttackTime:0, patrolAngle:Math.random()*Math.PI*2, convertedUntil:0, launch:null };
}

let isGodMode = false;
window.adminCallbacks = {};

function makeState(diffKey, mapKey) {
  const diff = DIFFS[diffKey];
  const enemies = Array.from({length:diff.enemies},(_,i)=>createEnemy(i, diff));
  const p = createPlayer(diff);
  if (isGodMode) p.isGodMode = true;
  const allies = Array.from({length:INITIAL_ALLIES},(_,i)=>createAlly(i,p.position));
  return { status:'playing', diff, diffKey, mapKey, players:[p], allies, enemies, projectiles:[], buildings:[], explosions:[], fireworks:[], banner:null, zone:{center:{x:CENTER,y:CENTER},radius:WORLD_SIZE*0.7,targetRadius:WORLD_SIZE*0.15,shrinking:false,damage:diff.zoneDmg}, remainingPlayers:enemies.length+1+INITIAL_ALLIES, elapsedTime:0, inHouse:null };
}

function mkFw(x, y, size, delay, hue, life, startY) {
  return { x, y, size, delay, delay0:delay, hue, age:0, life, startY: startY === undefined ? y : startY };
}

function heartPt(k, n) {
  const a = (k / n) * Math.PI * 2;
  return { x: 16 * Math.pow(Math.sin(a), 3), y: -(13*Math.cos(a) - 5*Math.cos(2*a) - 2*Math.cos(3*a) - Math.cos(4*a)) };
}
function heartPath(ctx, cx, cy, s) {
  ctx.beginPath();
  ctx.moveTo(cx, cy + s*0.9);
  ctx.bezierCurveTo(cx - s*1.6, cy - s*0.2, cx - s*0.9, cy - s*1.3, cx, cy - s*0.4);
  ctx.bezierCurveTo(cx + s*0.9, cy - s*1.3, cx + s*1.6, cy - s*0.2, cx, cy + s*0.9);
  ctx.closePath();
}

// ===== メニュー =====
function Menu({ onStart }) {
  const [diff, setDiff] = useState('normal');
  const [map, setMap] = useState('grass');
  return (
    <div className="menu">
      <h1>BATTLE ARENA</h1>
      <div className="menu-sub">難易度とマップを選んで決定を押してください</div>
      <div className="menu-sec">難易度</div>
      <div className="row">
        {Object.entries(DIFFS).map(([k, d]) => (
          <button key={k} className={'opt' + (diff === k ? ' sel' : '')} style={{'--c': d.color}} onClick={() => setDiff(k)}>
            <div className="opt-name" style={{color: d.color}}>{d.name}</div>
            <div className="opt-desc" style={{whiteSpace:'pre-line'}}>{d.desc}</div>
          </button>
        ))}
      </div>
      <div className="menu-sec">マップ</div>
      <div className="row">
        {Object.entries(MAPS).map(([k, m]) => (
          <button key={k} className={'map-card' + (map === k ? ' sel' : '')} onClick={() => setMap(k)}>
            <div className="map-prev" style={{background:`linear-gradient(135deg, ${m.ground[0]}, ${m.ground[2]})`}}>{m.icon}</div>
            <div className="opt-name">{m.name}</div>
            <div className="opt-desc">{m.desc}</div>
          </button>
        ))}
      </div>
      <div className="menu-sel">選択中：{DIFFS[diff].name} ／ {MAPS[map].name}</div>
      <button className="start-btn" onClick={() => onStart({ difficulty: diff, map })}>決定</button>
    </div>
  );
}

function Game({ config, onMenu }) {
  const canvasRef = useRef(null);
  const worldRef = useRef(null);
  if (!worldRef.current) worldRef.current = makeWorld(config.map);
  const [gameState, setGameState] = useState(() => makeState(config.difficulty, config.map));
  const gsRef = useRef(gameState);
  useEffect(() => { window.gameStateRef = gsRef.current; window.getGS = () => gsRef.current; }, [gameState]);
  const keysRef = useRef(new Set());
  const prevKeysRef = useRef(new Set());
  const mouseRef = useRef({x:400,y:300});
  const mdownRef = useRef(false);
  const ltRef = useRef(0);
  const lstRef = useRef(0);

  useEffect(() => { gsRef.current = gameState; }, [gameState]);

  const resetGame = useCallback(() => {
    const ns = makeState(config.difficulty, config.map);
    setGameState(ns); gsRef.current = ns; keysRef.current = new Set(); prevKeysRef.current = new Set();
  }, []);

  useEffect(() => {
    window.adminCallbacks.killAll = () => { const s = gsRef.current; if (s.status === 'playing') s.enemies.forEach(e => e.health = 0); };
    window.adminCallbacks.heal = () => { const s = gsRef.current; if (s.status === 'playing' && s.players[0]) { s.players[0].health = s.players[0].maxHealth; s.players[0].shield = s.players[0].maxShield; } };
    window.adminCallbacks.maxAmmo = () => { const s = gsRef.current; if (s.status === 'playing' && s.players[0]) { Object.keys(s.players[0].ammo).forEach(k => { if (s.players[0].ammo[k] !== Infinity) s.players[0].ammo[k] = WEAPONS[k].maxAmmo; }); } };
    window.adminCallbacks.speedUp = () => { const s = gsRef.current; if (s.status === 'playing' && s.players[0]) s.players[0].speedBoost = (s.players[0].speedBoost || 1) * 1.5; };
    window.adminCallbacks.spawnEnemies = () => {
      const s = gsRef.current;
      if (s.status !== 'playing') return;
      const startIdx = s.enemies.length + Math.floor(Math.random()*1000);
      for (let i = 0; i < 5; i++) s.enemies.push(createEnemy(startIdx + i, s.diff, 'enemy-spawn-'));
      s.remainingPlayers = s.enemies.length + 1 + s.allies.length;
    };
  }, []);

  const updateGame = useCallback((dt) => {
    const prev = gsRef.current;

    // 花火・バナーは常に更新（勝利後も動かす）
    prev.fireworks = prev.fireworks.filter(f => { if (f.delay > 0) f.delay -= dt; else f.age += dt; return f.age < f.life; });
    if (prev.banner) { prev.banner.t -= dt; if (prev.banner.t <= 0) prev.banner = null; }

    if (prev.status !== 'playing') return;
    const p = prev.players[0]; if (!p) return;
    const world = worldRef.current;
    const diff = prev.diff;
    const keys = keysRef.current;
    const prevKeys = prevKeysRef.current;
    const mouse = mouseRef.current;
    const md = mdownRef.current;

    const speed = (p.isGodMode ? 500 : 320) * (p.speedBoost || 1);
    let dx = 0, dy = 0;
    if (keys.has('w') || keys.has('arrowup')) dy -= 1;
    if (keys.has('s') || keys.has('arrowdown')) dy += 1;
    if (keys.has('a') || keys.has('arrowleft')) dx -= 1;
    if (keys.has('d') || keys.has('arrowright')) dx += 1;
    if (dx !== 0 || dy !== 0) {
      const len = Math.sqrt(dx*dx + dy*dy);
      dx = (dx/len) * speed * dt;
      dy = (dy/len) * speed * dt;
      p.position.x = Math.max(50, Math.min(WORLD_SIZE-50, p.position.x + dx));
      p.position.y = Math.max(50, Math.min(WORLD_SIZE-50, p.position.y + dy));
    }

    const canvas = canvasRef.current;
    const cw = canvas ? canvas.width : 800;
    const ch = canvas ? canvas.height : 600;
    const worldMouseX = mouse.x + p.position.x - cw/2;
    const worldMouseY = mouse.y + p.position.y - ch/2;
    p.angle = Math.atan2(worldMouseY - p.position.y, worldMouseX - p.position.x);

    // 飛行機乗り中の処理
    if (p.inPlane) {
      p.planeTimer -= dt;
      p.position.x += Math.cos(p.angle) * 400 * dt;
      p.position.y += Math.sin(p.angle) * 400 * dt;
      if (md && !p.nukeDropped) {
        p.nukeDropped = true;
        p.planeTarget = { x: p.position.x, y: p.position.y };
      }
      if (p.planeTimer <= 0) {
        p.inPlane = false;
        if (p.nukeDropped) {
          const tx = p.planeTarget.x, ty = p.planeTarget.y;
          prev.explosions.push({ position:{x:tx,y:ty}, radius:7000, damage:99999, lifetime:3 });
          prev.enemies.forEach(e => { const d = Math.sqrt((e.position.x-tx)**2+(e.position.y-ty)**2); if (d < 7000) e.health = 0; });
          p.nukeDropped = false;
        }
      }
    }

    // 家の中にいるかチェック
    let inAnyHouse = false;
    world.houses.forEach(h => {
      if (p.position.x > h.x - h.w/2 && p.position.x < h.x + h.w/2 && p.position.y > h.y - h.h/2 && p.position.y < h.y + h.h/2) {
        inAnyHouse = true;
      }
    });
    prev.inHouse = inAnyHouse;
    if (inAnyHouse) {
      p.health = Math.min(p.maxHealth, p.health + 5 * dt);
      p.shield = Math.min(p.maxShield, p.shield + 3 * dt);
    }

    // 溶岩だまり（火山マップ）
    world.pools.forEach(pl => {
      if (Math.hypot(p.position.x - pl.x, p.position.y - pl.y) < pl.r && !p.isGodMode) p.health -= 12 * dt;
    });

    if (p.isGodMode) {
      p.health = p.maxHealth; p.shield = p.maxShield;
      Object.keys(p.ammo).forEach(k => { if (p.ammo[k] !== Infinity) p.ammo[k] = WEAPONS[k].maxAmmo; });
    }

    const now = Date.now();
    const w = WEAPONS[p.currentWeapon];
    if (md && w && now - lstRef.current > w.fireRate) {
      if (p.ammo[p.currentWeapon] === undefined) p.ammo[p.currentWeapon] = w.maxAmmo;
      const ammo = p.isGodMode ? Infinity : p.ammo[p.currentWeapon];
      if (ammo > 0 || ammo === Infinity) {
        if (!p.isGodMode && ammo !== Infinity) p.ammo[p.currentWeapon]--;
        lstRef.current = now;
        if (w.type === 'melee') {
          if (w.id === 'katana') {
            prev.enemies.forEach(e => {
              if (e.convertedUntil > now) return;
              const d = Math.sqrt((e.position.x-p.position.x)**2 + (e.position.y-p.position.y)**2);
              if (d < 180) { e.health = 0; prev.explosions.push({ position:{...e.position}, radius:40, damage:0, lifetime:0.5 }); }
            });
          } else {
            prev.enemies.forEach(e => {
              if (e.convertedUntil > now) return;
              const d = Math.sqrt((e.position.x-p.position.x)**2 + (e.position.y-p.position.y)**2);
              if (d < 60) e.health -= p.isGodMode ? 9999 : w.damage;
            });
          }
        } else if (w.id === 'dragon') {
          const sp = (Math.random()-0.5) * w.spread;
          const a = p.angle + sp;
          prev.projectiles.push({ id:`proj-${now}-dragon`, position:{x:p.position.x+Math.cos(a)*40,y:p.position.y+Math.sin(a)*40}, velocity:{x:Math.cos(a)*w.projectileSpeed,y:Math.sin(a)*w.projectileSpeed}, ownerId:p.id, damage:w.damage, type:w.type, lifetime:4, isDragon:true });
        } else if (w.id === 'nuke') {
          if (!p.inPlane) {
            p.inPlane = true; p.planeTimer = 20;
            p.planeTarget = { x: p.position.x, y: p.position.y };
          }
        } else if (w.id === 'dopa') {
          // ドパ銃：当たった敵を10秒間仲間にする
          const a = p.angle;
          prev.projectiles.push({ id:`proj-${now}-dopa`, position:{x:p.position.x+Math.cos(a)*40,y:p.position.y+Math.sin(a)*40}, velocity:{x:Math.cos(a)*w.projectileSpeed,y:Math.sin(a)*w.projectileSpeed}, ownerId:p.id, damage:0, type:'ranged', lifetime:2, isDopa:true });
        } else if (w.id === 'precure') {
          // エセプリキュアのステッキ：近くの敵を空へ飛ばしてハート花火
          prev.enemies.forEach(e => {
            if (e.health <= 0 || e.launch) return;
            const d = Math.hypot(e.position.x - p.position.x, e.position.y - p.position.y);
            if (d < 400) { e.launch = { t: 0 }; e.convertedUntil = 0; }
          });
          const px = p.position.x, py = p.position.y;
          prev.fireworks.push(mkFw(px, py - 150, 8, 0.5, 330, 2.4, py + 60));
          prev.fireworks.push(mkFw(px - 250, py - 120, 4.5, 0.8, 290, 2.2, py + 60));
          prev.fireworks.push(mkFw(px + 250, py - 120, 4.5, 1.0, 45, 2.2, py + 60));
          prev.banner = { text:'✨ エセプリキュア♡ハートバースト！ ✨', t:2.5 };
        } else {
          const sp = (Math.random()-0.5) * w.spread;
          const a = p.angle + sp;
          const projCount = w.id === '67gun' ? 67 : (w.id === 'shotgun' ? 5 : 1);
          for (let i = 0; i < projCount; i++) {
            const pa = w.id === '67gun' ? a + (Math.random()-0.5)*0.5 : (w.id === 'shotgun' ? a + (Math.random()-0.5)*0.3 : a);
            prev.projectiles.push({ id:`proj-${now}-${i}`, position:{x:p.position.x+Math.cos(a)*30,y:p.position.y+Math.sin(a)*30}, velocity:{x:Math.cos(pa)*w.projectileSpeed,y:Math.sin(pa)*w.projectileSpeed}, ownerId:p.id, damage:w.damage, type:w.type, lifetime:3 });
          }
        }
      }
    }

    // 建築モード切替（単発検出）
    if (keys.has('b') && !prevKeys.has('b')) { p.isBuilding = !p.isBuilding; if (p.isBuilding) p.buildMode = 'wall'; }
    if (p.isBuilding) {
      if (keys.has('q') && !prevKeys.has('q')) p.buildMode = 'wall';
      if (keys.has('e') && !prevKeys.has('e')) p.buildMode = 'stair';
      if (keys.has('f') && !prevKeys.has('f')) p.buildMode = 'floor';
      if (keys.has('escape') && !prevKeys.has('escape')) p.isBuilding = false;
      if (keys.has(' ') && !prevKeys.has(' ') && p.buildMode && p.materials.wood >= 10) {
        p.materials.wood -= 10;
        prev.buildings.push({ id:`bld-${now}`, type:p.buildMode, position:{x:p.position.x+Math.cos(p.angle)*90,y:p.position.y+Math.sin(p.angle)*90}, health:200, maxHealth:200 });
      }
    }

    // 武器切替（単発検出）
    const equip = (wid) => {
      if (!WEAPONS[wid]) return;
      if (p.ammo[wid] === undefined) p.ammo[wid] = WEAPONS[wid].maxAmmo;
      p.currentWeapon = wid;
    };
    const wk = {'1':'fists','2':'shotgun','3':'rifle','4':'machinegun','5':'rocket','6':'8gun','7':'67gun','8':'dragon','9':'katana','0':'nuke'};
    Object.keys(wk).forEach(k => {
      if (keys.has(k) && !prevKeys.has(k)) equip(wk[k]);
    });
    if (keys.has('l') && !prevKeys.has('l')) equip('dopa');                              // Lキー：ドパ銃
    if (!p.isBuilding && keys.has('q') && !prevKeys.has('q')) equip('precure');          // Qキー：ステッキ（建築OFF時）

    const centerDist = (e) => Math.hypot(e.position.x - CENTER, e.position.y - CENTER);

    // 敵AI
    prev.enemies.forEach(e => {
      if (e.health <= 0) return;

      // ステッキで空へ飛ばされ中
      if (e.launch) {
        e.launch.t += dt;
        if (e.launch.t >= 1.3) {
          e.health = 0;
          prev.fireworks.push(mkFw(e.position.x, e.position.y - 260, 2.6, 0, 330, 1.4));
        }
        return;
      }

      // ドパ銃で味方化中
      if (e.convertedUntil > now) {
        const dpp = Math.hypot(p.position.x - e.position.x, p.position.y - e.position.y);
        if (dpp > 140) {
          const a = Math.atan2(p.position.y - e.position.y, p.position.x - e.position.x);
          e.position.x += Math.cos(a) * 160 * dt;
          e.position.y += Math.sin(a) * 160 * dt;
        }
        let tgt = null, td = Infinity;
        prev.enemies.forEach(o => {
          if (o === e || o.health <= 0 || o.launch || o.convertedUntil > now) return;
          const d = Math.hypot(o.position.x - e.position.x, o.position.y - e.position.y);
          if (d < td && d < 400) { td = d; tgt = o; }
        });
        if (tgt && now - e.lastAttackTime > 600) {
          e.lastAttackTime = now;
          const a = Math.atan2(tgt.position.y - e.position.y, tgt.position.x - e.position.x);
          prev.projectiles.push({ id:`cp-${now}-${e.id}`, position:{x:e.position.x,y:e.position.y}, velocity:{x:Math.cos(a)*650,y:Math.sin(a)*650}, ownerId:`ally-conv-${e.id}`, damage:12, type:'ranged', lifetime:2 });
        }
        return;
      }
      if (e.convertedUntil) { e.convertedUntil = 0; e.state = 'chase'; e.targetId = p.id; } // 10秒経過→敵に戻る

      const dp = Math.sqrt((p.position.x-e.position.x)**2 + (p.position.y-e.position.y)**2);
      if (e.state === 'patrol') {
        e.patrolAngle += (Math.random()-0.5) * 0.05;
        // 中央から離れすぎたら中央へ戻る
        if (centerDist(e) > 1800) {
          e.patrolAngle = Math.atan2(CENTER - e.position.y, CENTER - e.position.x) + (Math.random()-0.5) * 0.5;
        }
        e.position.x += Math.cos(e.patrolAngle) * 70 * dt;
        e.position.y += Math.sin(e.patrolAngle) * 70 * dt;
        e.position.x = Math.max(50, Math.min(WORLD_SIZE-50, e.position.x));
        e.position.y = Math.max(50, Math.min(WORLD_SIZE-50, e.position.y));
        if (dp < diff.detect) { e.state = 'chase'; e.targetId = p.id; }
      } else if (e.state === 'chase') {
        const a = Math.atan2(p.position.y - e.position.y, p.position.x - e.position.x);
        e.position.x += Math.cos(a) * 110 * diff.enemySpeed * dt;
        e.position.y += Math.sin(a) * 110 * diff.enemySpeed * dt;
        if (dp > diff.detect + 300) { e.state = 'patrol'; e.targetId = null; }
        if (dp < 200 && now - e.lastAttackTime > 1000) {
          e.lastAttackTime = now;
          if (!prev.inHouse && !p.isGodMode) { const dmg = diff.enemyDmg; if (p.shield > 0) p.shield = Math.max(0, p.shield - dmg); else p.health -= dmg; }
        }
      }
    });

    // 味方AI
    prev.allies.forEach(ally => {
      if (ally.health <= 0) return;
      const dp = Math.sqrt((p.position.x-ally.position.x)**2 + (p.position.y-ally.position.y)**2);
      if (dp > 120) {
        const a = Math.atan2(p.position.y - ally.position.y, p.position.x - ally.position.x);
        ally.position.x += Math.cos(a) * 100 * dt;
        ally.position.y += Math.sin(a) * 100 * dt;
      }
      let ne = null, nd = Infinity;
      prev.enemies.forEach(e => { if (e.health <= 0 || e.launch || e.convertedUntil > now) return; const d = Math.sqrt((e.position.x-ally.position.x)**2 + (e.position.y-ally.position.y)**2); if (d < nd && d < 300) { nd = d; ne = e; } });
      if (ne && now - ally.lastAttackTime > 800) {
        ally.lastAttackTime = now;
        const a = Math.atan2(ne.position.y - ally.position.y, ne.position.x - ally.position.x);
        prev.projectiles.push({ id:`ap-${now}-${ally.id}`, position:{x:ally.position.x,y:ally.position.y}, velocity:{x:Math.cos(a)*600,y:Math.sin(a)*600}, ownerId:ally.id, damage:8, type:'ranged', lifetime:2 });
      }
    });

    // 弾丸更新
    prev.projectiles = prev.projectiles.filter(proj => {
      proj.position.x += proj.velocity.x * dt;
      proj.position.y += proj.velocity.y * dt;
      proj.lifetime -= dt;
      if (proj.lifetime <= 0) return false;
      if (proj.position.x < 0 || proj.position.x > WORLD_SIZE || proj.position.y < 0 || proj.position.y > WORLD_SIZE) return false;
      if (proj.ownerId === 'player' || proj.ownerId.startsWith('ally-')) {
        prev.enemies.forEach(e => {
          if (proj.lifetime <= 0) return;
          if (e.health <= 0 || e.launch || e.convertedUntil > now) return;
          const d = Math.sqrt((e.position.x-proj.position.x)**2 + (e.position.y-proj.position.y)**2);
          if (d < 25) {
            if (proj.isDopa) {
              e.convertedUntil = now + 10000; e.state = 'converted'; proj.lifetime = 0;
              prev.explosions.push({ position:{...e.position}, radius:50, damage:0, lifetime:0.3 });
              return;
            }
            e.health -= proj.damage; proj.lifetime = 0;
            if (proj.type === 'explosive') {
              prev.explosions.push({ position:{...proj.position}, radius:100, damage:80, lifetime:0.3 });
              prev.enemies.forEach(e2 => { if (e2.health <= 0) return; const d2 = Math.sqrt((e2.position.x-proj.position.x)**2 + (e2.position.y-proj.position.y)**2); if (d2 < 100) e2.health -= 80 * (1 - d2/100); });
            }
            if (proj.isDragon) {
              prev.enemies.forEach(e2 => { if (e2.health <= 0) return; const d2 = Math.sqrt((e2.position.x-proj.position.x)**2 + (e2.position.y-proj.position.y)**2); if (d2 < 80) e2.health = 0; });
            }
          }
        });
      }
      if (proj.ownerId.startsWith('enemy-')) {
        if (!prev.inHouse) {
          const d = Math.sqrt((p.position.x-proj.position.x)**2 + (p.position.y-proj.position.y)**2);
          if (d < 25) { if (!p.isGodMode) { if (p.shield > 0) p.shield = Math.max(0, p.shield - proj.damage); else p.health -= proj.damage; } proj.lifetime = 0; }
        }
        prev.allies.forEach(ally => {
          if (ally.health <= 0) return;
          const da = Math.sqrt((ally.position.x-proj.position.x)**2 + (ally.position.y-proj.position.y)**2);
          if (da < 25) { ally.health -= proj.damage; proj.lifetime = 0; }
        });
      }
      prev.buildings.forEach(b => { const d = Math.sqrt((b.position.x-proj.position.x)**2 + (b.position.y-proj.position.y)**2); if (d < 40) { b.health -= proj.damage; proj.lifetime = 0; } });
      return proj.lifetime > 0;
    });

    prev.explosions = prev.explosions.filter(e => { e.lifetime -= dt; return e.lifetime > 0; });

    prev.elapsedTime += dt;
    if (prev.elapsedTime > 30 && !prev.zone.shrinking) prev.zone.shrinking = true;
    if (prev.zone.shrinking) prev.zone.radius = Math.max(prev.zone.targetRadius, prev.zone.radius - 20 * dt);
    const dzc = Math.sqrt((p.position.x-prev.zone.center.x)**2 + (p.position.y-prev.zone.center.y)**2);
    if (dzc > prev.zone.radius && !p.isGodMode) p.health -= prev.zone.damage * dt;

    prev.enemies = prev.enemies.filter(e => e.health > 0);
    prev.allies = prev.allies.filter(a => a.health > 0);
    prev.buildings = prev.buildings.filter(b => b.health > 0);

    const hostile = prev.enemies.filter(e => !(e.convertedUntil > now)).length;
    if (p.health <= 0 && !p.isGodMode) {
      prev.status = 'lost';
      setTimeout(() => resetGame(), 2000);
    } else if (hostile === 0) {
      prev.status = 'won';
    }
    prev.remainingPlayers = prev.enemies.length + 1 + prev.allies.length;

    prevKeysRef.current = new Set(keys);
  }, [resetGame]);

  useEffect(() => {
    let aid;
    const loop = (ts) => {
      if (!ltRef.current) ltRef.current = ts;
      const dt = Math.min((ts - ltRef.current) / 1000, 0.05);
      ltRef.current = ts;
      updateGame(dt);
      renderFrame();
      aid = requestAnimationFrame(loop);
    };
    aid = requestAnimationFrame(loop);
    return () => cancelAnimationFrame(aid);
  }, [updateGame]);

  useEffect(() => {
    const kd = (e) => {
      if (e.target && e.target.tagName === 'INPUT') return; // コード入力中はゲーム操作しない
      const k = e.key.toLowerCase();
      keysRef.current.add(k);
      const st = gsRef.current.status;
      if (k === 'r' && st === 'won') resetGame();
      if (k === 'm' && st === 'won') onMenu();
    };
    const ku = (e) => keysRef.current.delete(e.key.toLowerCase());
    const mm = (e) => {
      const c = canvasRef.current; if (!c) return;
      const r = c.getBoundingClientRect();
      mouseRef.current = { x: e.clientX - r.left, y: e.clientY - r.top };
    };
    const md = (e) => { if (e.button === 0) mdownRef.current = true; };
    const mu = (e) => { if (e.button === 0) mdownRef.current = false; };
    window.addEventListener('keydown', kd);
    window.addEventListener('keyup', ku);
    window.addEventListener('mousemove', mm);
    window.addEventListener('mousedown', md);
    window.addEventListener('mouseup', mu);
    return () => {
      window.removeEventListener('keydown', kd); window.removeEventListener('keyup', ku);
      window.removeEventListener('mousemove', mm); window.removeEventListener('mousedown', md); window.removeEventListener('mouseup', mu);
    };
  }, [resetGame]);

  const renderFrame = () => {
    const c = canvasRef.current; if (!c) return;
    const ctx = c.getContext('2d');
    const w = c.width, h = c.height;
    ctx.clearRect(0, 0, w, h);
    renderGame(ctx, w, h);
  };

  const drawTree = (ctx, t, m) => {
    if (m.treeStyle === 'cactus') {
      ctx.fillStyle = '#2e7d32';
      ctx.fillRect(t.x-5, t.y-t.r, 10, t.r*1.6);
      ctx.fillRect(t.x-t.r*0.7, t.y-t.r*0.2, t.r*0.7, 6);
      ctx.fillRect(t.x-t.r*0.7, t.y-t.r*0.7, 6, t.r*0.55);
      ctx.fillRect(t.x, t.y-t.r*0.4, t.r*0.7, 6);
      ctx.fillRect(t.x+t.r*0.7-6, t.y-t.r*0.9, 6, t.r*0.55);
      ctx.fillStyle = '#43a047'; ctx.fillRect(t.x-2, t.y-t.r, 3, t.r*1.5);
    } else if (m.treeStyle === 'pine') {
      ctx.fillStyle = '#5D4037'; ctx.fillRect(t.x-4, t.y+4, 8, 14);
      ctx.fillStyle = '#1b5e3b';
      ctx.beginPath(); ctx.moveTo(t.x, t.y-t.r*1.5); ctx.lineTo(t.x+t.r, t.y+8); ctx.lineTo(t.x-t.r, t.y+8); ctx.closePath(); ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.beginPath(); ctx.moveTo(t.x, t.y-t.r*1.5); ctx.lineTo(t.x+t.r*0.45, t.y-t.r*0.5); ctx.lineTo(t.x-t.r*0.45, t.y-t.r*0.5); ctx.closePath(); ctx.fill();
    } else if (m.treeStyle === 'dead') {
      ctx.strokeStyle = '#1a1210'; ctx.lineWidth = 5; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(t.x, t.y+10); ctx.lineTo(t.x, t.y-t.r); ctx.stroke();
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(t.x, t.y-t.r*0.4); ctx.lineTo(t.x-t.r*0.6, t.y-t.r*0.9); ctx.moveTo(t.x, t.y-t.r*0.6); ctx.lineTo(t.x+t.r*0.6, t.y-t.r*1.1); ctx.stroke();
    } else {
      ctx.fillStyle = '#5D4037'; ctx.beginPath(); ctx.arc(t.x, t.y+5, t.r*0.3, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#2E7D32'; ctx.beginPath(); ctx.arc(t.x, t.y-5, t.r, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#388E3C'; ctx.beginPath(); ctx.arc(t.x-3, t.y-8, t.r*0.7, 0, Math.PI*2); ctx.fill();
    }
  };

  const drawWeapon = (ctx, we) => {
    ctx.fillStyle = '#1a1a1a';
    if (we.id === 'rifle' || we.id === 'machinegun') { ctx.fillRect(18,-2,we.id==='machinegun'?45:38,7); ctx.fillStyle='#333'; ctx.fillRect(50,-3,10,9); }
    else if (we.id === 'shotgun') { ctx.fillRect(18,0,35,10); ctx.fillStyle='#8B4513'; ctx.fillRect(48,-2,15,14); }
    else if (we.id === 'rocket') { ctx.fillStyle='#c0392b'; ctx.fillRect(18,-5,28,12); ctx.fillStyle='#f39c12'; ctx.beginPath(); ctx.arc(46,1,7,0,Math.PI*2); ctx.fill(); }
    else if (we.id === 'dragon') { ctx.fillStyle='#fff'; ctx.fillRect(18,-4,36,10); ctx.fillStyle='rgba(255,255,255,0.7)'; ctx.beginPath(); ctx.arc(-20,0,14,0,Math.PI*2); ctx.fill(); }
    else if (we.id === 'katana') { ctx.strokeStyle='#C0C0C0'; ctx.lineWidth=4; ctx.beginPath(); ctx.moveTo(18,-2); ctx.lineTo(60,6); ctx.stroke(); ctx.fillStyle='#8B0000'; ctx.fillRect(14,-6,8,14); }
    else if (we.id === 'nuke') { ctx.fillStyle='#555'; ctx.fillRect(18,-6,22,14); ctx.fillStyle='#e74c3c'; ctx.beginPath(); ctx.arc(28,1,5,0,Math.PI*2); ctx.fill(); }
    else if (we.id === 'dopa') { ctx.fillStyle='#7d3cff'; ctx.fillRect(18,-4,34,11); ctx.fillStyle='#ff6bd6'; ctx.beginPath(); ctx.arc(54,1,6,0,Math.PI*2); ctx.fill(); ctx.fillStyle='#fff'; ctx.fillRect(22,-1,10,4); }
    else if (we.id === 'precure') {
      ctx.strokeStyle='#ffd6f3'; ctx.lineWidth=5; ctx.lineCap='round'; ctx.beginPath(); ctx.moveTo(18,2); ctx.lineTo(54,2); ctx.stroke();
      ctx.fillStyle='#ff4fa3'; heartPath(ctx, 64, 2, 10); ctx.fill();
      ctx.fillStyle='#ffe66d'; ctx.beginPath(); ctx.arc(26,2,3,0,Math.PI*2); ctx.fill();
    }
    else { ctx.fillRect(18,-3,38,8); }
  };

  const drawFireworks = (ctx, fws) => {
    fws.forEach(f => {
      if (f.delay > 0) {
        // 打ち上げ中のロケット
        const r = f.delay0 > 0 ? 1 - f.delay / f.delay0 : 1;
        const ry = f.startY + (f.y - f.startY) * r;
        ctx.save();
        ctx.shadowColor = '#ff9ae0'; ctx.shadowBlur = 14;
        for (let k = 0; k < 6; k++) { ctx.fillStyle = `rgba(255,170,230,${0.7 - k*0.1})`; ctx.beginPath(); ctx.arc(f.x, ry + k*9, 5 - k*0.6, 0, Math.PI*2); ctx.fill(); }
        ctx.restore();
        return;
      }
      const prog = f.age / f.life;
      const ease = 1 - Math.pow(1 - Math.min(1, prog*2), 3);
      const s = f.size * (0.15 + 0.85*ease);
      const alpha = prog < 0.55 ? 1 : Math.max(0, 1 - (prog-0.55)/0.45);
      const droop = prog*prog*50;
      ctx.save();
      if (prog < 0.18) {
        const fa = 1 - prog/0.18;
        const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, 40*f.size*0.5 + 20);
        g.addColorStop(0, `rgba(255,220,245,${fa*0.85})`); g.addColorStop(1, 'rgba(255,150,220,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(f.x, f.y, 40*f.size*0.5 + 20, 0, Math.PI*2); ctx.fill();
      }
      ctx.globalAlpha = alpha;
      ctx.shadowColor = `hsl(${f.hue},100%,70%)`; ctx.shadowBlur = 10;
      const layers = [[1,64,4.5],[0.66,40,3.2],[0.33,24,2.6]];
      layers.forEach(([ls, n, rad], li) => {
        for (let k = 0; k < n; k++) {
          const pt = heartPt(k, n);
          const x = f.x + pt.x * s * ls, y = f.y + pt.y * s * ls + droop;
          ctx.fillStyle = `hsl(${(f.hue + li*12 + (k%4)*8) % 360},100%,${li===0?68:78}%)`;
          ctx.beginPath(); ctx.arc(x, y, rad * (f.size > 5 ? 1 : 0.7), 0, Math.PI*2); ctx.fill();
        }
      });
      ctx.restore();
    });
  };

  const drawWinEffect = (ctx, w, h) => {
    const t = Date.now();
    ctx.save();
    ctx.fillStyle = 'rgba(0,0,0,0.45)'; ctx.fillRect(0, 0, w, h);

    // 回転する虹色の放射光
    ctx.save(); ctx.translate(w/2, h/2); ctx.rotate(t * 0.0007);
    const rays = 28, R = Math.hypot(w, h);
    for (let i = 0; i < rays; i += 2) {
      ctx.fillStyle = `hsla(${(i * 360 / rays + t * 0.25) % 360},100%,55%,0.55)`;
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.arc(0, 0, R, i * Math.PI*2 / rays, (i+1) * Math.PI*2 / rays); ctx.closePath(); ctx.fill();
    }
    ctx.restore();

    // フラッシュ
    if (Math.floor(t / 110) % 5 === 0) { ctx.fillStyle = 'rgba(255,255,255,0.35)'; ctx.fillRect(0, 0, w, h); }

    // 周囲を流れる電飾
    const px = 12, pw = w - 24, ph = h - 24, per = 2 * (pw + ph), nb = 60;
    for (let i = 0; i < nb; i++) {
      const d = (i / nb) * per; let x, y;
      if (d < pw) { x = px + d; y = px; }
      else if (d < pw + ph) { x = px + pw; y = px + (d - pw); }
      else if (d < 2*pw + ph) { x = px + pw - (d - pw - ph); y = px + ph; }
      else { x = px; y = px + ph - (d - 2*pw - ph); }
      const on = ((i + Math.floor(t / 90)) % 3 === 0);
      ctx.fillStyle = on ? `hsl(${(i * 20 + t * 0.4) % 360},100%,60%)` : 'rgba(255,255,255,0.25)';
      ctx.beginPath(); ctx.arc(x, y, on ? 9 : 6, 0, Math.PI*2); ctx.fill();
    }

    // 紙吹雪
    for (let i = 0; i < 90; i++) {
      const x = (i * 97.3 + Math.sin(t * 0.001 + i) * 30 + w) % w;
      const y = (t * (0.12 + (i % 7) * 0.03) + i * 41) % h;
      ctx.save(); ctx.translate(x, y); ctx.rotate(t * 0.004 + i);
      ctx.fillStyle = `hsl(${(i * 37 + t * 0.2) % 360},100%,60%)`; ctx.fillRect(-5, -3, 10, 6); ctx.restore();
    }

    // 「大当たり!!」
    const pulse = 1 + 0.08 * Math.sin(t * 0.02);
    ctx.save();
    ctx.translate(w/2 + (Math.random()-0.5)*6, h/2 - 40 + (Math.random()-0.5)*6); ctx.scale(pulse, pulse);
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.lineJoin = 'round';
    ctx.font = "bold 84px Orbitron, 'Hiragino Kaku Gothic ProN','Yu Gothic','Meiryo',sans-serif";
    ctx.lineWidth = 18; ctx.strokeStyle = '#000'; ctx.strokeText('大当たり!!', 0, 0);
    ctx.lineWidth = 9; ctx.strokeStyle = '#fff'; ctx.strokeText('大当たり!!', 0, 0);
    const g = ctx.createLinearGradient(-260, 0, 260, 0);
    for (let k = 0; k <= 6; k++) g.addColorStop(k / 6, `hsl(${(k * 60 + t * 0.4) % 360},100%,55%)`);
    ctx.shadowColor = `hsl(${(t * 0.5) % 360},100%,60%)`; ctx.shadowBlur = 30;
    ctx.fillStyle = g; ctx.fillText('大当たり!!', 0, 0);
    ctx.restore();

    // 7 7 7 リール
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    for (let k = 0; k < 3; k++) {
      const x = w/2 + (k - 1) * 90, y = h/2 + 70;
      ctx.fillStyle = '#fff'; ctx.fillRect(x - 38, y - 42, 76, 84);
      ctx.lineWidth = 6; ctx.strokeStyle = `hsl(${(t * 0.5 + k * 80) % 360},100%,55%)`; ctx.strokeRect(x - 38, y - 42, 76, 84);
      ctx.font = "bold 64px Orbitron, sans-serif";
      ctx.fillStyle = `hsl(${(t * 0.6 + k * 60) % 360},100%,50%)`; ctx.fillText('7', x, y + 2);
    }

    // 操作案内
    ctx.font = "20px Orbitron, 'Hiragino Kaku Gothic ProN','Yu Gothic','Meiryo',sans-serif";
    ctx.fillStyle = Math.floor(t / 400) % 2 ? '#fff' : '#ffe66d';
    ctx.fillText('R：もう一度　／　M：メニューへ', w/2, h/2 + 150);
    ctx.restore();
  };

  const renderGame = (ctx, w, h) => {
    const gs = gsRef.current;
    const p = gs.players[0];
    const world = worldRef.current;
    const m = world.m;
    if (!p) { ctx.fillStyle = '#0a0a15'; ctx.fillRect(0,0,w,h); return; }
    const now = Date.now();
    ctx.fillStyle = m.bg; ctx.fillRect(0,0,w,h);
    ctx.save();
    const camX = w/2 - p.position.x, camY = h/2 - p.position.y;
    ctx.translate(camX, camY);

    const vx0 = p.position.x - w/2 - 120, vx1 = p.position.x + w/2 + 120;
    const vy0 = p.position.y - h/2 - 120, vy1 = p.position.y + h/2 + 120;
    const vis = (x, y) => x > vx0 && x < vx1 && y > vy0 && y < vy1;

    const seed = 12345;
    const gStartX = Math.max(0, Math.floor(vx0 / 200) * 200), gStartY = Math.max(0, Math.floor(vy0 / 200) * 200);
    for (let gx = gStartX; gx < Math.min(WORLD_SIZE, vx1); gx += 200) {
      for (let gy = gStartY; gy < Math.min(WORLD_SIZE, vy1); gy += 200) {
        ctx.fillStyle = m.ground[Math.floor((gx * 7 + gy * 13 + seed) % m.ground.length)];
        ctx.fillRect(gx, gy, 200, 200);
      }
    }

    ctx.strokeStyle = m.road; ctx.lineWidth = 40;
    ctx.beginPath(); ctx.moveTo(CENTER - 600, CENTER); ctx.lineTo(CENTER + 600, CENTER); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(CENTER, CENTER - 600); ctx.lineTo(CENTER, CENTER + 600); ctx.stroke();

    // 溶岩だまり
    world.pools.forEach(pl => {
      if (!vis(pl.x, pl.y)) return;
      const g = ctx.createRadialGradient(pl.x, pl.y, 0, pl.x, pl.y, pl.r);
      const flick = 0.85 + 0.15 * Math.sin(now * 0.004 + pl.x);
      g.addColorStop(0, `rgba(255,220,80,${flick})`); g.addColorStop(0.6, 'rgba(255,100,20,0.95)'); g.addColorStop(1, 'rgba(120,20,0,0.9)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(pl.x, pl.y, pl.r, 0, Math.PI*2); ctx.fill();
    });

    const z = gs.zone;
    ctx.fillStyle = 'rgba(255,50,50,0.12)'; ctx.beginPath(); ctx.arc(z.center.x, z.center.y, z.radius, 0, Math.PI*2); ctx.fill();
    ctx.strokeStyle = 'rgba(255,80,80,0.6)'; ctx.lineWidth = 5; ctx.setLineDash([15, 10]); ctx.stroke(); ctx.setLineDash([]);

    world.trees.forEach(t => { if (vis(t.x, t.y)) drawTree(ctx, t, m); });

    world.rocks.forEach(r => {
      if (!vis(r.x, r.y)) return;
      ctx.fillStyle = '#757575'; ctx.beginPath(); ctx.ellipse(r.x, r.y, r.r*0.8, r.r*0.5, 0, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#9E9E9E'; ctx.beginPath(); ctx.ellipse(r.x-2, r.y-2, r.r*0.5, r.r*0.3, 0, 0, Math.PI*2); ctx.fill();
    });

    world.houses.forEach(ho => {
      if (!vis(ho.x, ho.y)) return;
      ctx.fillStyle = '#8D6E63'; ctx.fillRect(ho.x - ho.w/2, ho.y - ho.h/2, ho.w, ho.h);
      ctx.fillStyle = '#5D4037'; ctx.beginPath(); ctx.moveTo(ho.x - ho.w/2 - 5, ho.y - ho.h/2); ctx.lineTo(ho.x, ho.y - ho.h/2 - 25); ctx.lineTo(ho.x + ho.w/2 + 5, ho.y - ho.h/2); ctx.closePath(); ctx.fill();
      ctx.fillStyle = '#42A5F5'; ctx.fillRect(ho.x - 15, ho.y - 5, 12, 12); ctx.fillRect(ho.x + 3, ho.y - 5, 12, 12);
      ctx.fillStyle = '#3E2723'; ctx.fillRect(ho.x - 8, ho.y + 5, 16, 15);
    });

    gs.buildings.forEach(b => {
      ctx.save(); ctx.translate(b.position.x, b.position.y);
      if (b.type === 'wall') { ctx.fillStyle = '#8B4513'; ctx.fillRect(-35,-35,70,70); ctx.strokeStyle = '#5D4E37'; ctx.lineWidth = 3; ctx.strokeRect(-35,-35,70,70); ctx.fillStyle = '#333'; ctx.fillRect(-35,-50,70,6); ctx.fillStyle = '#2ecc71'; ctx.fillRect(-35,-50,70*(b.health/b.maxHealth),6); }
      else if (b.type === 'stair') { ctx.fillStyle = '#A0522D'; ctx.beginPath(); ctx.moveTo(-35,35); ctx.lineTo(35,35); ctx.lineTo(35,-35); ctx.closePath(); ctx.fill(); }
      else if (b.type === 'floor') { ctx.fillStyle = '#CD853F'; ctx.fillRect(-50,-50,100,100); }
      ctx.restore();
    });

    gs.allies.forEach(a => {
      ctx.save(); ctx.translate(a.position.x, a.position.y);
      ctx.fillStyle = 'rgba(0,0,0,0.3)'; ctx.beginPath(); ctx.ellipse(0,20,18,7,0,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = '#3498db'; ctx.beginPath(); ctx.ellipse(0,6,16,20,0,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = '#F5D0C5'; ctx.beginPath(); ctx.arc(0,-18,12,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(-3,-16,3,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.arc(3,-16,3,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = '#000'; ctx.beginPath(); ctx.arc(-3,-16,1.5,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.arc(3,-16,1.5,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = '#333'; ctx.fillRect(-20,-38,40,6); ctx.fillStyle = '#2ecc71'; ctx.fillRect(-20,-38,40*(a.health/a.maxHealth),6);
      ctx.restore();
    });

    gs.enemies.forEach(e => {
      if (!vis(e.position.x, e.position.y - 300)) return;
      const conv = e.convertedUntil > now;
      ctx.save(); ctx.translate(e.position.x, e.position.y);
      ctx.fillStyle = 'rgba(0,0,0,0.3)'; ctx.beginPath(); ctx.ellipse(0,20,18,7,0,0,Math.PI*2); ctx.fill();
      if (e.launch) {
        const lt = e.launch.t;
        const lift = 260 * Math.min(1, lt / 1.2);
        for (let k = 0; k < 4; k++) { ctx.fillStyle = `rgba(255,150,220,${0.6 - k*0.12})`; ctx.beginPath(); ctx.arc(0, -lift + 30 + k*14, 7 - k, 0, Math.PI*2); ctx.fill(); }
        ctx.translate(0, -lift); ctx.rotate(lt * 8); const sc = 1 - 0.5 * (lt / 1.3); ctx.scale(sc, sc);
      }
      if (conv) {
        const remain = e.convertedUntil - now;
        ctx.strokeStyle = 'rgba(199,125,255,0.9)'; ctx.lineWidth = 4;
        ctx.beginPath(); ctx.arc(0, 0, 40, -Math.PI/2, -Math.PI/2 + Math.PI*2 * (remain / 10000)); ctx.stroke();
        ctx.fillStyle = '#d9a8ff'; ctx.font = 'bold 14px Orbitron, sans-serif'; ctx.textAlign = 'center'; ctx.fillText(`${Math.ceil(remain/1000)}`, 0, -52); ctx.textAlign = 'left';
      }
      ctx.fillStyle = conv ? '#8e44ad' : '#8B0000'; ctx.beginPath(); ctx.ellipse(0,6,16,20,0,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = '#DEB887'; ctx.beginPath(); ctx.arc(0,-18,12,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(-4,-20,4,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.arc(4,-20,4,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = conv ? '#ff6bd6' : '#e74c3c'; ctx.beginPath(); ctx.arc(-4,-20,2,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.arc(4,-20,2,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = '#333'; ctx.fillRect(-22,-42,44,7); ctx.fillStyle = conv ? '#b07cff' : '#e74c3c'; ctx.fillRect(-22,-42,44*Math.max(0, e.health/e.maxHealth),7);
      ctx.restore();
    });

    gs.projectiles.forEach(proj => {
      const dopa = proj.isDopa;
      const g = ctx.createRadialGradient(proj.position.x, proj.position.y, 0, proj.position.x, proj.position.y, 20);
      g.addColorStop(0, dopa ? 'rgba(210,130,255,0.95)' : 'rgba(255,230,109,0.9)'); g.addColorStop(1, dopa ? 'rgba(210,130,255,0)' : 'rgba(255,230,109,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(proj.position.x, proj.position.y, 20, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = dopa ? '#ff6bd6' : '#ffe66d'; ctx.beginPath(); ctx.arc(proj.position.x, proj.position.y, 5, 0, Math.PI*2); ctx.fill();
    });

    gs.explosions.forEach(exp => {
      const a = Math.min(1, exp.lifetime / 0.3);
      ctx.fillStyle = `rgba(255,100,50,${a*0.6})`; ctx.beginPath(); ctx.arc(exp.position.x, exp.position.y, exp.radius*(1-a*0.3), 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = `rgba(255,200,100,${a*0.4})`; ctx.beginPath(); ctx.arc(exp.position.x, exp.position.y, exp.radius*0.5*(1-a*0.3), 0, Math.PI*2); ctx.fill();
    });

    ctx.save(); ctx.translate(p.position.x, p.position.y); ctx.rotate(p.angle);
    ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(0,22,22,9,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = '#2C3E50'; ctx.fillRect(-14,8,10,22); ctx.fillRect(4,8,10,22);
    if (p.isGodMode) { ctx.shadowColor = '#ffe66d'; ctx.shadowBlur = 25; }
    ctx.fillStyle = '#27AE60'; ctx.beginPath(); ctx.moveTo(-16,-8); ctx.lineTo(16,-8); ctx.lineTo(14,18); ctx.lineTo(-14,18); ctx.closePath(); ctx.fill();
    ctx.shadowBlur = 0;
    ctx.strokeStyle = '#1E8449'; ctx.lineWidth = 2; ctx.stroke();
    ctx.fillStyle = '#F5D0C5'; ctx.beginPath(); ctx.arc(0,-16,13,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = '#5D4E37'; ctx.beginPath(); ctx.arc(0,-20,11,Math.PI,0); ctx.fill();
    ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(-4,-16,4,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.arc(4,-16,4,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = '#2C3E50'; ctx.beginPath(); ctx.arc(-4,-16,2,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.arc(4,-16,2,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = '#F5D0C5'; ctx.fillRect(16,-6,10,20); ctx.fillRect(-26,-6,10,20);
    const we = WEAPONS[p.currentWeapon];
    if (we) drawWeapon(ctx, we);
    ctx.restore();

    if (p.isBuilding && p.buildMode) { const px = p.position.x + Math.cos(p.angle)*90, py = p.position.y + Math.sin(p.angle)*90; ctx.fillStyle = 'rgba(139,69,19,0.5)'; ctx.fillRect(px-35,py-35,70,70); ctx.strokeStyle='#fff'; ctx.lineWidth=3; ctx.setLineDash([8,8]); ctx.strokeRect(px-35,py-35,70,70); ctx.setLineDash([]); }

    // ハート花火（プレイヤーの頭上に表示）
    drawFireworks(ctx, gs.fireworks);

    ctx.restore();

    renderHUD(ctx, w, h);
  };

  const renderHUD = (ctx, w, h) => {
    const gs = gsRef.current;
    const p = gs.players[0]; if (!p) return;
    ctx.fillStyle = '#16213e'; ctx.fillRect(20, h-70, 220, 35); ctx.fillStyle = '#e74c3c'; ctx.fillRect(22, h-68, 216*Math.max(0,p.health/p.maxHealth), 31);
    if (p.shield > 0) { ctx.fillStyle = '#3498db'; ctx.fillRect(22, h-35, 216*Math.min(1,p.shield/p.maxShield), 10); }
    ctx.fillStyle = '#fff'; ctx.font = 'bold 14px Orbitron, sans-serif'; ctx.fillText(`HP:${Math.round(Math.max(0,p.health))}`, 250, h-45);
    ctx.font = 'bold 22px Orbitron, sans-serif'; ctx.fillStyle = '#ffe66d'; ctx.fillText(`👥 ${gs.remainingPlayers}`, w-140, 45);
    const aa = gs.allies.filter(a => a.health > 0).length; if (aa > 0) { ctx.fillStyle = '#3498db'; ctx.fillText(`+${aa} 味方`, w-140, 75); }
    const m = Math.floor(gs.elapsedTime/60), s = Math.floor(gs.elapsedTime%60);
    ctx.fillText(`${m}:${s.toString().padStart(2,'0')}`, w-140, 105);
    const we = WEAPONS[p.currentWeapon];
    ctx.fillStyle = '#16213e'; ctx.fillRect(20, h-140, 200, 55); ctx.fillStyle = '#ff6b35';
    ctx.font = (we.name.length > 8 ? 'bold 12px' : 'bold 18px') + ' Orbitron, sans-serif'; ctx.fillText(we.name, 30, h-110);
    ctx.fillStyle = '#fff'; ctx.font = '14px Orbitron, sans-serif'; ctx.fillText(`弾丸:${p.ammo[p.currentWeapon]===Infinity?'∞':p.ammo[p.currentWeapon]}`, 30, h-85);
    ctx.fillStyle = '#16213e'; ctx.fillRect(w-220, h-70, 200, 55); ctx.fillStyle = '#8b4513'; ctx.fillText(`🪵 ${p.materials.wood}`, w-210, h-45); ctx.fillStyle = '#808080'; ctx.fillText(`🪨 ${p.materials.stone}`, w-110, h-45);
    if (p.isBuilding) { ctx.fillStyle = '#4ecdc4'; ctx.font = 'bold 16px Orbitron, sans-serif'; ctx.fillText(`🔨 建築:${p.buildMode?.toUpperCase()}`, w/2-100, 45); }
    if (gs.inHouse) { ctx.fillStyle = '#2ecc71'; ctx.font = 'bold 14px Orbitron, sans-serif'; ctx.fillText('🏠 家の中 - 回復中', w/2-80, 70); }
    ctx.fillStyle = '#fff'; ctx.font = '12px Orbitron, sans-serif'; ctx.fillText(`📍 X:${Math.round(p.position.x)} Y:${Math.round(p.position.y)}`, 20, h-160);
    if (p.inPlane) { ctx.fillStyle = '#e74c3c'; ctx.font = 'bold 18px Orbitron, sans-serif'; ctx.fillText(`✈️ 飛行機モード 残り${p.planeTimer.toFixed(1)}秒`, w/2-150, 140); }
    ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '11px Orbitron, sans-serif'; ctx.fillText('WASD:移動 | クリック:射撃 | 1-5:武器 | B:建築 | Q/E/F:壁/階段/床', 20, 30);
    ctx.fillStyle = 'rgba(255,255,255,0.55)'; ctx.fillText(`${MAPS[gs.mapKey].name} / ${gs.diff.name}`, 20, 48);
    const extra = [];
    if (WEAPONS.dopa) extra.push('L:ドパ銃');
    if (WEAPONS.precure) extra.push('Q:ステッキ♡(建築OFF時)');
    if (extra.length) { ctx.fillStyle = 'rgba(255,180,230,0.8)'; ctx.fillText(extra.join(' | '), 20, 64); }
    if (p.isGodMode) { ctx.fillStyle = '#ffe66d'; ctx.font = 'bold 18px Orbitron, sans-serif'; ctx.textAlign = 'center'; ctx.fillText('★ GOD MODE ★', w/2, h-20); ctx.textAlign = 'left'; }

    if (gs.banner) {
      ctx.save(); ctx.textAlign = 'center'; ctx.font = "bold 22px Orbitron, 'Hiragino Kaku Gothic ProN','Yu Gothic','Meiryo',sans-serif";
      ctx.globalAlpha = Math.min(1, gs.banner.t * 2);
      ctx.shadowColor = '#ff4fa3'; ctx.shadowBlur = 18; ctx.fillStyle = '#ffd6f3';
      ctx.fillText(gs.banner.text, w/2, 100);
      ctx.restore();
    }

    if (gs.status === 'won') { drawWinEffect(ctx, w, h); }
    else if (gs.status === 'lost') { ctx.fillStyle = 'rgba(0,0,0,0.8)'; ctx.fillRect(0,0,w,h); ctx.fillStyle = '#e74c3c'; ctx.font = 'bold 52px Orbitron, sans-serif'; ctx.textAlign = 'center'; ctx.fillText('💀 敗北 💀', w/2, h/2); ctx.font = '24px Orbitron, sans-serif'; ctx.fillText('リスタート中...', w/2, h/2+60); ctx.textAlign = 'left'; }
  };

  return <canvas ref={canvasRef} width={800} height={600} style={{maxWidth:'100%',maxHeight:'100%'}} />;
}

function App() {
  const [config, setConfig] = useState(null);
  const [runId, setRunId] = useState(0);
  if (!config) return <Menu onStart={(c) => { setConfig(c); setRunId(r => r + 1); }} />;
  return <Game key={runId} config={config} onMenu={() => setConfig(null)} />;
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);

// ===== トースト表示 =====
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.style.opacity = 1;
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(() => { t.style.opacity = 0; }, 4000);
}
function giveWeapon(def, ammo) {
  if (WEAPONS[def.id]) return false;
  WEAPONS[def.id] = def;
  const s = window.getGS ? window.getGS() : null;
  if (s && s.players && s.players[0]) s.players[0].ammo[def.id] = ammo;
  return true;
}

