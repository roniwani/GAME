<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>smileAI</title>
  <style>
    :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif;color:#4b3900;background:#fff8d8}*{box-sizing:border-box}body{margin:0;min-width:320px;background:#fff8d8}.app{min-height:100vh;display:flex;background:#fff8d8}.sidebar{width:276px;flex:0 0 276px;display:flex;flex-direction:column;padding:22px 14px 14px;background:#fff0a5;border-right:1px solid #ead477}.brand{display:flex;align-items:center;gap:9px;padding:0 10px;font-weight:800;font-size:18px;letter-spacing:.02em}.brand-mark{width:25px;height:25px;border-radius:8px;display:grid;place-items:center;color:#fffbed;background:#6b9848;font-size:15px}.beta{font-size:8px;color:#9a8130;letter-spacing:.12em}.new-chat{height:44px;margin:24px 2px 26px;border:1px solid #7ba757;border-radius:11px;background:#6b9848;color:#fffbea;font-weight:700;text-align:left;padding:0 14px;font-size:13px;cursor:pointer}.new-chat:hover,.send:hover{background:#7ba754}.section{margin:0 10px 10px;color:#9a8336;font-size:11px;font-weight:700;letter-spacing:.08em}.nav{display:grid;gap:4px}.nav button,.settings{border:0;border-radius:10px;background:transparent;color:#7b6b32;text-align:left;padding:11px 12px;cursor:pointer}.nav button.active,.nav button:hover,.settings:hover{background:#ffe681;color:#4b3900}.nav button span{float:right;color:#a18d4b}.history{display:flex;justify-content:space-between;align-items:center;margin:30px 10px 10px;color:#9a8336;font-size:11px;font-weight:700}.search{margin:0 5px 10px;border:1px solid #ead47e;border-radius:9px;background:#fff7ce;padding:10px 11px;color:#8d7939}.search input{border:0;outline:0;background:transparent;width:calc(100% - 8px);color:#5e4c18}.thread{border:1px solid #e7cc62;border-radius:10px;background:#ffe685;color:#4b3900;padding:10px 12px;font-size:12px}.thread small{display:block;color:#9b8848;margin-top:3px}.bottom{margin-top:auto;border-top:1px solid #e4cf72;padding-top:14px}.profile{display:flex;align-items:center;gap:10px;padding:8px 7px}.avatar{width:31px;height:31px;border-radius:10px;display:grid;place-items:center;color:#fffbed;background:#6b9848;font-weight:700}.profile strong{font-size:12px}.profile small{display:block;color:#9b8848;margin-top:2px}.main{min-width:0;flex:1;min-height:100vh;display:flex;flex-direction:column;background:radial-gradient(circle at 80% -20%,rgba(255,224,82,.22),transparent 33%),#fff8d8}.header{height:77px;display:flex;align-items:center;justify-content:space-between;padding:0 31px;border-bottom:1px solid #ead987}.eyebrow{font-size:10px;letter-spacing:.12em;color:#9c8843;font-weight:700}.title{margin:6px 0 0;font-size:16px}.model{border:1px solid #dfc95f;border-radius:10px;background:#fff1a3;color:#5b480c;padding:10px 14px;font-size:12px}.stage{flex:1;display:flex;align-items:center;justify-content:center;padding:34px 20px}.welcome{text-align:center;max-width:720px;width:100%}.core{width:54px;height:54px;margin:0 auto 20px;border-radius:18px;display:grid;place-items:center;color:#fffbe5;background:#6b9848;border:1px solid #d7b82d;box-shadow:0 0 40px rgba(229,191,42,.24);font-size:25px;transform:rotate(-5deg)}.kicker{font-size:10px;letter-spacing:.18em;color:#9d8842;font-weight:800}.welcome h1{margin:15px 0 12px;font-size:38px;letter-spacing:-.06em}.welcome h1 em{color:#6b9848;font-style:normal}.welcome p{margin:0 0 28px;color:#8c783c;font-size:13px;line-height:1.8}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;max-width:610px;margin:auto}.card{display:flex;align-items:center;gap:11px;text-align:left;border:1px solid #e7d57a;border-radius:12px;background:rgba(255,253,239,.78);padding:14px;cursor:pointer;color:#77662e}.card:hover{background:#fff9d8;border-color:#c9ad3e}.card-icon{width:28px;height:28px;display:grid;place-items:center;border:1px solid #d9bc40;border-radius:9px;background:#fff0a3;color:#6b9848}.card strong{display:block;color:#5a4610;font-size:12px}.card small{display:block;color:#9b884c;font-size:10px;margin-top:4px}.composer-wrap{padding:0 9% 22px}.composer{border:1px solid #ddc75f;border-radius:15px;background:#fffdf0;box-shadow:0 10px 38px rgba(172,141,37,.12);padding:14px 17px 10px}.composer:focus-within{border-color:#b99a27;box-shadow:0 0 0 3px rgba(222,190,46,.12),0 12px 44px rgba(172,141,37,.13)}textarea{display:block;width:100%;min-height:31px;max-height:180px;resize:vertical;border:0;outline:0;background:transparent;color:#5e4d1c;font:inherit;font-size:13px}textarea::placeholder{color:#a39157}.composer-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:7px;color:#9a884e;font-size:10px}.send{width:31px;height:31px;border:0;border-radius:9px;color:#fffbed;background:#6b9848;cursor:pointer}.send:disabled{opacity:.45;cursor:default}.note{text-align:center;color:#9d8a51;font-size:9px;margin-top:10px}.messages{width:min(760px,100%);margin:auto;text-align:left}.message{margin:12px 0;padding:13px 16px;border:1px solid #e6d889;border-radius:13px;background:#fffdf0;white-space:pre-wrap;line-height:1.7;font-size:14px}.message.user{margin-left:18%;color:#fffbe9;background:#6b9848;border-color:#78a653}.mobile-menu{display:none}.clear{border:0;background:transparent;color:#8c793b;cursor:pointer}@media(max-width:720px){.sidebar{position:fixed;z-index:3;inset:0 auto 0 0;width:min(286px,88vw);transform:translateX(-102%);transition:.2s}.sidebar.open{transform:translateX(0)}.mobile-menu{display:block;border:0;background:transparent;color:#6b6f59;font-size:20px}.header{height:68px;padding:0 16px}.header-right{display:flex;gap:8px;align-items:center}.stage{padding:26px 14px}.welcome h1{font-size:32px}.cards{grid-template-columns:1fr}.composer-wrap{padding:0 11px 12px}.message.user{margin-left:8%}.overlay{display:none;position:fixed;z-index:2;inset:0;background:rgba(78,61,0,.22)}.overlay.show{display:block}}
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar" id="sidebar">
      <div class="brand"><div class="brand-mark">✦</div><span>smileAI</span><span class="beta">BETA</span></div>
      <button class="new-chat" id="newChat">＋　新しい会話</button>
      <div class="section">ワークスペース</div>
      <div class="nav"><button class="active">◯　すべての会話 <span id="count">1</span></button><button>✧　お気に入り</button></div>
      <div class="history"><span>最近の会話</span><span>⌕</span></div>
      <div class="search">⌕ <input placeholder="会話を検索" /></div>
      <div class="thread" id="thread">新しい会話<small>今</small></div>
      <div class="bottom"><button class="settings">☷　設定</button><div class="profile"><div class="avatar">N</div><div><strong>ゲスト</strong><small>無料プラン</small></div></div></div>
    </aside>
    <div class="overlay" id="overlay"></div>
    <main class="main">
      <header class="header"><div style="display:flex;align-items:center;gap:12px"><button class="mobile-menu" id="menu">☰</button><div><div class="eyebrow">WORKSPACE / CHAT</div><div class="title" id="title">新しい会話</div></div></div><div class="header-right"><div class="model">⚡ GPT-5 mini⌄</div><button class="clear" id="newTop">＋</button></div></header>
      <section class="stage" id="stage"><div class="welcome" id="welcome"><div class="core">✣</div><div class="kicker">smileAI ASSISTANT　✦</div><h1>思考を、<em>明るく。</em></h1><p>アイデアを広げる。複雑なことを整理する。<br>あなたの毎日に、知的な余白を。</p><div class="cards"><button class="card" data-prompt="新しいプロダクトのアイデアを3つ考えて"><span class="card-icon">✦</span><span><strong>アイデアを広げる</strong><small>新しいプロダクトのアイデアを3つ考えて</small></span></button><button class="card" data-prompt="この文章を、読みやすくプロフェッショナルに整えて"><span class="card-icon">✦</span><span><strong>文章を磨く</strong><small>この文章を読みやすく整えて</small></span></button><button class="card" data-prompt="量子コンピュータを初心者向けに説明して"><span class="card-icon">✦</span><span><strong>学びを深める</strong><small>量子コンピュータを初心者向けに説明して</small></span></button><button class="card" data-prompt="今週の生産性を上げるための計画を作って"><span class="card-icon">✦</span><span><strong>計画をつくる</strong><small>今週の生産性を上げるための計画を作って</small></span></button></div></div><div class="messages" id="messages" hidden></div></section>
      <div class="composer-wrap"><div class="composer"><textarea id="input" rows="1" placeholder="smileAIにメッセージを送る..." maxlength="50000"></textarea><div class="composer-bottom"><span>⌘ Enter　｜ 改行</span><button class="send" id="send" disabled>↑</button></div></div><div class="note">smileAIは誤った情報を生成することがあります。重要な内容はご確認ください。</div></div>
    </main>
  </div>
  <script>
    const input=document.getElementById('input'),send=document.getElementById('send'),welcome=document.getElementById('welcome'),messages=document.getElementById('messages'),title=document.getElementById('title'),thread=document.getElementById('thread'),count=document.getElementById('count');
    function showMessage(text,role){const el=document.createElement('div');el.className='message '+role;el.textContent=text;messages.appendChild(el);messages.hidden=false;welcome.hidden=true;return el}
    function reply(text){const el=showMessage('回答を生成しています…','assistant');setTimeout(()=>{el.textContent='これは単体HTML版のsmileAIです。実際のAI回答を接続する場合は、外部APIを安全なサーバー経由で設定してください。\n\n受け取った内容：'+text},350)}
    function submit(text=input.value.trim()){if(!text)return;showMessage(text,'user');title.textContent=text.slice(0,30);thread.firstChild.textContent=title.textContent;thread.querySelector('small').textContent='今';count.textContent='1';input.value='';send.disabled=true;reply(text)}
    input.addEventListener('input',()=>send.disabled=!input.value.trim());input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();submit()}});send.addEventListener('click',()=>submit());document.querySelectorAll('[data-prompt]').forEach(b=>b.addEventListener('click',()=>{input.value=b.dataset.prompt;submit()}));function newChat(){messages.innerHTML='';messages.hidden=true;welcome.hidden=false;title.textContent='新しい会話';thread.firstChild.textContent='新しい会話';input.value='';send.disabled=true}document.getElementById('newChat').addEventListener('click',newChat);document.getElementById('newTop').addEventListener('click',newChat);const sidebar=document.getElementById('sidebar'),overlay=document.getElementById('overlay');document.getElementById('menu').addEventListener('click',()=>{sidebar.classList.add('open');overlay.classList.add('show')});overlay.addEventListener('click',()=>{sidebar.classList.remove('open');overlay.classList.remove('show')});
  </script>
</body>
</html>
